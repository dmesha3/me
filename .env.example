# Notes sync (optional). Without these, /notes works as a local-only clipboard.
# Any Postgres works: Neon, Supabase, or Vercel Postgres.
# For Supabase, prefer the pooler connection string if the direct db.<project>.supabase.co
# host does not resolve from your network.
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Passphrase that unlocks notes sync in the browser. Pick something strong.
NOTES_PASSPHRASE="choose-a-strong-passphrase"

# Optional: separate secret for signing sync sessions.
# Defaults to NOTES_PASSPHRASE when unset.
NOTES_SESSION_SECRET="a-long-random-string"
