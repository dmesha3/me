DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres"

# Passphrase that unlocks notes sync in the browser. Pick something strong.
NOTES_PASSPHRASE="choose-a-strong-passphrase"

# Optional: separate secret for signing sync sessions.
# Defaults to NOTES_PASSPHRASE when unset.
NOTES_SESSION_SECRET="a-long-random-string"
